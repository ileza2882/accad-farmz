# InsForge Database Configuration
# Leave VITE_INSFORGE_URL and VITE_INSFORGE_API_KEY empty OR set VITE_DISCONNECT_DATABASE=true
# to run the app in standalone offline mode completely disconnected from any remote database.
VITE_INSFORGE_PROJECT_NAME=accadfarms
VITE_INSFORGE_URL=
VITE_INSFORGE_API_KEY=
VITE_DISCONNECT_DATABASE=true

# ---------------------------------------------------------------------------
# Outbound email
# ---------------------------------------------------------------------------
# PRIMARY SENDER - Resend, DKIM-signed as accadfarms.com.
#
# This is the setting that keeps staff credential emails out of the spam folder. Mail sent through
# the Gmail fallback below authenticates as gmail.com no matter what address is in the From header,
# so accadfarms.com earns no sending reputation and the message is scored alongside every consumer
# Gmail account on the internet.
#
# Setup:
#   1. Create an account at resend.com and add the domain "send.accadfarms.com".
#   2. Add the DKIM, SPF and MX records Resend shows you to Namecheap DNS (see docs/EMAIL_SETUP.md).
#   3. Wait for Resend to report the domain Verified.
#   4. Set RESEND_API_KEY here for local dev, and in the Cloudflare Pages dashboard under
#      Settings -> Environment variables for production.
RESEND_API_KEY=
RESEND_FROM=ACCAD FARMS <noreply@send.accadfarms.com>

# Monitored mailbox that staff replies land in.
MAIL_REPLY_TO=info@accadfarms.com

# FALLBACK SENDER - Gmail SMTP. Used only when Resend is unset or returns an error.
# Deliverability here is materially worse; treat it as a safety net, not the intended path.
GMAIL_USER=accadfarmsapp@gmail.com
GMAIL_APP_PASSWORD=

# ---------------------------------------------------------------------------
# Firebase Cloud Messaging (browser push notifications)
# ---------------------------------------------------------------------------
# Push reaches devices that have already opted in: the staff member opened the portal and granted
# notification permission. It is NOT a delivery channel for a brand new account - someone the ED
# registered a moment ago has no device registered, so there is nothing to send to. Welcome
# credentials go by email; the two are not interchangeable.
#
# Setup:
#   1. console.firebase.google.com -> create/select project -> Project settings -> General ->
#      "Your apps" -> Web app. Copy the config values below.
#   2. Project settings -> Cloud Messaging -> Web Push certificates -> Generate key pair.
#      That public key is VITE_FIREBASE_VAPID_KEY.
#   3. Project settings -> Service accounts -> Generate new private key. Paste the WHOLE JSON file
#      as a single line into FIREBASE_SERVICE_ACCOUNT.
#   4. Apply migrations/004_push_tokens.sql to InsForge.
#
# These VITE_ values ship inside the client bundle and are public by design.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# SERVER ONLY. Never give this a VITE_ prefix - it can send to any device on the project.
# In Cloudflare Pages, add it as an ENCRYPTED environment variable.
FIREBASE_SERVICE_ACCOUNT=

# Cloudflare Pages deployment credentials
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
